#!/usr/bin/env bash
# Usage: git remove-merged-branches [options] [<base-branch> [<prefix>...]]
#
# Delete local branches that are merged into <base-branch> (default: the
# remote's default branch). Only branches whose names start with one of the
# <prefix>es are considered (all branches when none are given). <base-branch>
# and the checked-out branch are never deleted. A branch checked out in a linked
# worktree has that worktree removed first; a worktree with uncommitted changes
# is kept, and so is its branch. When the GitHub CLI (gh) is available, each
# branch is shown with the merged pull request it came from.
#
# Options:
#   -s, --squash-aware    Also delete branches whose changes landed in
#                         <base-branch> through a rebase or squash merge
#   -P, --pr-aware        Also delete branches that have a merged pull request
#                         with the same head branch name (requires gh)
#   -p, --push            Also delete the branches on the remote
#   -r, --remote <name>   Remote used for --push and the default branch (default: origin)
#   -n, --dry-run         List the branches without deleting anything
#   -y, --yes             Do not ask for confirmation
#   -h, --help            Show this help
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/git-scripts/common.sh
. "$SCRIPT_DIR/../lib/git-scripts/common.sh"

remote=origin
squash_aware=0
pr_aware=0
push=0
args=()
while (($#)); do
	case $1 in
	-s | --squash-aware) squash_aware=1 ;;
	-P | --pr-aware) pr_aware=1 ;;
	-p | --push) push=1 ;;
	-r | --remote)
		(($# > 1)) || die "$1 needs a value"
		remote=$2
		shift
		;;
	-n | --dry-run) DRY_RUN=1 ;;
	-y | --yes) ASSUME_YES=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		args+=("$@")
		break
		;;
	-*) die "unknown option: $1 (see --help)" ;;
	*) args+=("$1") ;;
	esac
	shift
done
set -- ${args[@]+"${args[@]}"}

require_repo
if (($# > 0)); then
	base_branch=$1
	shift
else
	base_branch=$(default_branch "$remote")
fi
is_branch "$base_branch" || die "$base_branch is not a local branch"
current=$(current_branch)

# True when every change on $1 is already in $base_branch, even though $1 is not
# an ancestor of it: each commit has a patch-equivalent commit in $base_branch
# (rebase merge), or the branch's combined diff does (squash merge).
landed_in_base() {
	local ref=$1 merge_base squashed unpicked
	# git cherry marks commits with no equivalent in $base_branch with "+".
	unpicked=$(git cherry "$base_branch" "$ref") || return 1
	[[ $'\n'$unpicked == *$'\n+'* ]] || return 0
	merge_base=$(git merge-base "$base_branch" "$ref") || return 1
	squashed=$(git commit-tree "$ref^{tree}" -p "$merge_base" -m "squash-check $ref") || return 1
	unpicked=$(git cherry "$base_branch" "$squashed") || return 1
	[[ $unpicked != +* ]]
}

# Linked worktrees as "<branch>\t<path>" lines. The main worktree (listed first)
# cannot be removed, so the branch checked out there is kept in $main_wt_branch.
linked_worktrees=''
main_wt_branch=''
wt_path=''
wt_index=0
while IFS= read -r line; do
	case $line in
	'worktree '*)
		wt_path=${line#worktree }
		wt_index=$((wt_index + 1))
		;;
	'branch refs/heads/'*)
		ref=${line#branch refs/heads/}
		if ((wt_index == 1)); then
			main_wt_branch=$ref
		else
			linked_worktrees+="$ref"$'\t'"$wt_path"$'\n'
		fi
		;;
	esac
done < <(git worktree list --porcelain)

# Print the path of the linked worktree that has $1 checked out, if any.
worktree_for_branch() {
	local head path
	[[ -n $linked_worktrees ]] || return 0
	while IFS=$'\t' read -r head path; do
		if [[ $head == "$1" ]]; then
			printf '%s\n' "$path"
			return 0
		fi
	done <<<"$linked_worktrees"
}

merged=()
while IFS= read -r ref; do
	merged+=("$ref")
done < <(git for-each-ref --merged "$base_branch" --format='%(refname:short)' 'refs/heads/' | sort)

# Merged pull requests as "<head branch>\t<url>" lines, newest first.
# Empty when gh is missing, unauthenticated, or the repository is not on GitHub.
merged_prs=''
if command -v gh >/dev/null 2>&1; then
	merged_prs=$(gh pr list --state merged --limit 500 --json headRefName,url \
		--jq '.[] | "\(.headRefName)\t\(.url)"' 2>/dev/null) || merged_prs=''
fi

# Print the URL of the newest merged pull request whose head branch is $1, if any.
pr_for_branch() {
	local head pr
	[[ -n $merged_prs ]] || return 0
	while IFS=$'\t' read -r head pr; do
		if [[ $head == "$1" ]]; then
			printf '%s\n' "$pr"
			return 0
		fi
	done <<<"$merged_prs"
}

[[ $pr_aware == 0 || -n $merged_prs ]] || die "--pr-aware needs gh to list merged pull requests"

candidates=()
while IFS= read -r ref; do
	[[ $ref == "$base_branch" || $ref == "$current" || $ref == "$main_wt_branch" ]] && continue
	if contains "$ref" ${merged[@]+"${merged[@]}"}; then
		candidates+=("$ref")
	elif [[ $squash_aware == 1 ]] && landed_in_base "$ref"; then
		candidates+=("$ref")
	elif [[ $pr_aware == 1 && -n $(pr_for_branch "$ref") ]]; then
		candidates+=("$ref")
	fi
done < <(list_branches "$@")

((${#candidates[@]} > 0)) || {
	info "No merged branches found."
	exit 0
}

info "These branches are merged into ${green}${base_branch}${nc} and will be ${yellow}deleted${nc}:"
for ref in "${candidates[@]}"; do
	line="  $ref"
	pr=$(pr_for_branch "$ref")
	[[ -n $pr ]] && line+="  ${green}${pr}${nc}"
	wt=$(worktree_for_branch "$ref")
	[[ -n $wt ]] && line+="  ${yellow}(worktree ${wt} will be removed)${nc}"
	printf '%s\n' "$line"
done
[[ $push == 1 ]] && info "Matching branches on $remote will be deleted too."
if [[ $DRY_RUN == 1 ]]; then
	exit 0
fi
confirm

failed=0
for ref in "${candidates[@]}"; do
	# Without --force, so a worktree with uncommitted changes is kept along with its branch.
	wt=$(worktree_for_branch "$ref")
	if [[ -n $wt ]] && ! git worktree remove "$wt"; then
		warn "keeping $ref: could not remove its worktree $wt"
		failed=1
		continue
	fi
	if [[ $push == 1 ]] && git ls-remote --exit-code --heads "$remote" "refs/heads/$ref" >/dev/null 2>&1; then
		git push "$remote" --delete "$ref" || failed=1
	fi
	# -D because -d checks against HEAD/upstream, not $base_branch; merging was verified above.
	git branch -D "$ref" || failed=1
done
exit "$failed"
